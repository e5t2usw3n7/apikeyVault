{
  "$schema": "https://raw.githubusercontent.com/nicerscheduler/tauri-apps-tauri/v2/crates/tauri-cli/schema.json",
  "productName": "API Key Vault",
  "version": "1.0.0",
  "identifier": "com.apikeyvault.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "API Key Vault",
        "width": 1100,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
